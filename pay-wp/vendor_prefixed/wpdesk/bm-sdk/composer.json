{
    "name": "wpdesk\/bm-sdk",
    "description": "Blue Media PHP SDK",
    "license": "LGPL-3.0-only",
    "require": {
        "php": ">=7.4",
        "guzzlehttp\/guzzle": "7.*",
        "jms\/serializer": "^1.14|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit\/phpunit": "^9.5",
        "wpdesk\/wp-code-sniffer": "^1",
        "wpdesk\/phpstan-rules": "^1"
    },
    "autoload": {
        "psr-4": {
            "WPPayVendor\\BlueMedia\\": "src\/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPPayVendor\\Tests\\": "tests\/"
        }
    },
    "archive": {
        "skip-dev": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect\/phpcodesniffer-composer-installer": true,
            "phpstan\/extension-installer": true
        }
    }
}